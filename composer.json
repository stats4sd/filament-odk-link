{
    "name": "stats4sd/odk-link-monorepo",
    "description": "Development workspace for the ODK Link packages and reference app. Not published.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "stats4sd/filament-odk-link": "dev-dev",
                    "stats4sd/odk-link-filament": "dev-dev"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "stats4sd/filament-odk-link": "dev-dev",
        "stats4sd/odk-link-filament": "dev-dev"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "scripts": {
        "test": "@test:core",
        "test:core": "@composer --working-dir=packages/odk-link-core test",
        "test:filament": "@composer --working-dir=packages/odk-link-filament test",
        "test:reference": "@composer --working-dir=apps/reference test",
        "test:all": [
            "@test:core",
            "@test:filament",
            "@test:reference"
        ],
        "analyse": "@analyse:core",
        "analyse:core": "@composer --working-dir=packages/odk-link-core analyse",
        "analyse:filament": "@composer --working-dir=packages/odk-link-filament analyse",
        "analyse:all": [
            "@analyse:core",
            "@analyse:filament"
        ],
        "format": "@format:core",
        "format:core": "@composer --working-dir=packages/odk-link-core format",
        "format:filament": "@composer --working-dir=packages/odk-link-filament format",
        "format:reference": "@composer --working-dir=apps/reference exec pint",
        "install:packages": [
            "@composer --working-dir=packages/odk-link-core install",
            "@composer --working-dir=packages/odk-link-filament install"
        ],
        "install:reference": "@composer --working-dir=apps/reference install",
        "install:all": [
            "@install:packages",
            "@install:reference"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
